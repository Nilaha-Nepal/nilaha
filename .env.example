# Browser-safe project URL + anon key. Never put the service-role key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Keep disabled until providers, staffing, privacy/retention and safeguarding are ready.
ENABLE_INTAKE=false
APP_ORIGIN=https://your-new-domain.example
PORT=3000
